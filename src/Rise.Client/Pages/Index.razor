@page "/"

<PageTitle>Stazzu La Vigna di Maria</PageTitle>

@* ---------- hero, photos of the estate fading one after the other behind the logo ---------- *@
<div class="hero">
    @* slideshow in css only, see Index.razor.css, each photo starts SlideSeconds after the previous one *@
    @* decorative, so hidden from screen readers *@
    <div class="hero-slides" aria-hidden="true">
        @for (var i = 0; i < HeroPhotos.Length; i++)
        {
            <img class="hero-slide" src="@HeroPhotos[i]" alt="" style="animation-delay: @(i * SlideSeconds)s" />
        }
    </div>

    <div class="hero-content">
        <img class="hero-logo" src="images/home/logo-white.png" alt="Stazzu La Vigna di Maria" />
        <h1 class="hero-title">Slow days among vines and granite</h1>

        @* shared search bar, same as on the search and results pages, goes to the results page *@
        @* TODO: guests and rooms fields of the mockup, when a story asks for them *@
        <SearchBar />
    </div>
</div>

@* ---------- the estate ---------- *@
<section class="home-section">
    <div class="home-inner estate">
        <div class="estate-text">
            <span class="eyebrow">The estate</span>
            <h2>A manor farm among three small vineyards</h2>
            <p class="home-muted">
                Stazzu La Vigna di Maria stands on 2.4 hectares of gardens, three small vineyards and a wood
                with granite rocks and caves. In one of those caves we found a small statue of Mary, which
                gave the estate its name.
            </p>
            <Button Variant="ButtonVariant.Secondary" Href="estate">Discover the estate</Button>
        </div>
        @* photos of the estate, same glass arrows as the room cards *@
        <div class="estate-photo">
            <PhotoCarousel Photos="@EstatePhotos" Alt="The estate of Stazzu La Vigna di Maria" />
        </div>
    </div>
</section>

@* ---------- rooms ---------- *@
<section class="home-section home-section-alt">
    <div class="home-inner">
        <span class="eyebrow">Our rooms</span>
        <h2>Three rooms, each with its own character</h2>

        <div class="card-grid">
            @foreach (var room in RoomList)
            {
                <article class="room-card">
                    @* photos of the room, the glass arrows show the next or previous one *@
                    <PhotoCarousel Photos="@room.Photos" Alt="@room.Name" />
                    <div class="room-card-body">
                        <h3>@room.Name</h3>
                        <p class="home-small home-muted">from €@room.Price per night · incl. VAT</p>
                        <a class="home-link" href="rooms">View room <i class="fas fa-arrow-right"></i></a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* ---------- reviews ---------- *@
<section class="home-section">
    <div class="home-inner">
        <span class="eyebrow">Reviews</span>
        <h2>What our guests say</h2>

        <div class="card-grid">
            @foreach (var review in ReviewList)
            {
                <article class="review-card">
                    <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <p>@review.Text</p>
                    <p class="home-small home-muted">@review.Author · @review.Source</p>
                </article>
            }
        </div>

        <a class="home-link review-all" href="reviews">Read all reviews on Google <i class="fas fa-arrow-right"></i></a>
    </div>
</section>

@code {
    // photos of the hero slideshow, in order, the css keyframes are made for 5 photos of 6 s each
    private const int SlideSeconds = 6;

    private static readonly string[] HeroPhotos =
    [
        "images/home/hero-1-house.jpg",
        "images/home/hero-2-room.jpg",
        "images/home/hero-3-sunset.jpg",
        "images/home/hero-4-beach.jpg",
        "images/home/hero-5-coast.jpg",
    ];

    // the 3 real rooms with all their photos, same data as the seed
    // TODO: load the rooms from the api, and the real standard room price from the client
    // photos of the estate section: the house, the garden, the breakfast terrace, a vineyard and the statue of the cave
    private static readonly string[] EstatePhotos =
    [
        "images/home/estate.jpg",
        "images/home/estate-2.jpg",
        "images/home/estate-3.jpg",
        "images/home/estate-4.jpg",
        "images/home/estate-5.jpg",
    ];

    private record RoomItem(string Name, int Price, string[] Photos);
    private record ReviewItem(string Text, string Author, string Source);

    private static readonly RoomItem[] RoomList =
    [
        new("Standard Room", 133, RoomPhotos("standard-room", 4)),
        new("Deluxe Room", 175, RoomPhotos("deluxe-room", 5)),
        new("Deluxe Room with bathtub", 175, RoomPhotos("deluxe-room-bathtub", 4)),
    ];

    // paths of the photos of a room in wwwroot/images/rooms, eg standard-room-1.jpg to standard-room-4.jpg
    private static string[] RoomPhotos(string name, int count) =>
        Enumerable.Range(1, count).Select(i => $"images/rooms/{name}-{i}.jpg").ToArray();

    private static readonly ReviewItem[] ReviewList =
    [
        new("A quiet, beautiful place among the vines. We will be back.", "Anna", "Google Reviews"),
        new("Warm hosts, stunning breakfast on the terrace.", "Marc", "Google Reviews"),
        new("Perfect base for exploring the coast.", "Sofia", "Facebook"),
    ];
}