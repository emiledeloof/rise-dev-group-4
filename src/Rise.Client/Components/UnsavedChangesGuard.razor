@* warns before unsaved form changes are lost, styles in UnsavedChangesGuard.razor.css *@
@* reload, closing the tab or an other site: the browser asks with its own dialog *@
@* a link of the app or an action of the page (cancel, edit an other row): our dialog below *@
<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<Dialog IsOpen="_pending is not null"
        Title="Discard your changes?"
        Description="You have changes that are not saved yet. They will be lost if you leave this form."
        Size="DialogSize.Small"
        IsAlert="true"
        ShowCloseButton="false"
        Class="unsaved-dialog"
        OnClose="() => Choose(false)">
    <Footer>
        <Button Variant="ButtonVariant.Danger" OnClick="() => Choose(true)" Class="unsaved-discard">Discard changes</Button>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => Choose(false)" Class="unsaved-keep">Keep editing</Button>
    </Footer>
</Dialog>
