@page "/admin/extra-services"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Client.Components
@using Rise.Shared.Identity
@using Rise.Shared.ExtraServices

<PageTitle>Extra Services</PageTitle>
<div class="page">
    <div class="rate-page-heading service-heading">
        <h1 class="title">Extra Services</h1>
        <div class="rate-page-actions">
            <Button OnClick="OpenCreateForm">New extra service</Button>
        </div>
    </div>

    @if (_services is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (_message is not null)
        {
            <p class="notification @(_messageIsError ? "is-danger" : "is-success") is-light">@_message</p>
        }

        <div class="box rate-list">
            @if (_services.Count == 0 && !_loadFailed)
            {
                <p class="rate-muted">No extra services yet.</p>
            }
            else
            {
                <div class="rate-table-scroll">
                    <table class="rate-table service-table">
                        <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Price</th>
                            <th scope="col">Cadence</th>
                            <th scope="col">Charging basis</th>
                            <th scope="col">Active</th>
                            <th scope="col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var service in _services)
                        {
                            <tr @key="service.Id" class="@(service.IsActive ? null : "rate-inactive-row")">
                                <td class="rate-name">
                                    <strong>@service.Name</strong>
                                </td>
                                <td class="service-description">@(service.Description ?? "—")</td>
                                <td class="rate-price">@FormatPrice(service.Price)</td>
                                <td>@(service.Cadence == ChargeCadence.PerNight ? "Per night" : "Once")</td>
                                <td>@(service.IsPerPerson ? "Per person" : "Per booking")</td>
                                <td>
                                    <label class="rate-switch">
                                        <input type="checkbox"
                                               role="switch"
                                               aria-label="@(service.IsActive ? $"Deactivate {service.Name}" : $"Activate {service.Name}")"
                                               checked="@service.IsActive"
                                               disabled="@_pendingActivations.Contains(service.Id)"
                                               @onchange="args => SetServiceActiveAsync(service, args)" />
                                        <span aria-hidden="true"></span>
                                        <span class="is-sr-only">@(service.IsActive ? "Active" : "Inactive")</span>
                                    </label>
                                </td>
                                <td>
                                    <Button Variant="ButtonVariant.Secondary"
                                            OnClick="() => OpenEditForm(service)"
                                            Class="rate-edit-btn">
                                        Edit
                                    </Button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (_formModel is not null)
        {
            <section class="rate-create-panel service-panel" aria-labelledby="service-form-heading">
                <h3 id="service-form-heading">@(_formModel is ExtraServiceRequest.Edit ? "Edit extra service" : "New extra service")</h3>

                <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                    <FluentValidationValidator />

                    <div class="rate-create-fields">
                        <label class="rate-create-field">
                            <span>Name</span>
                            <InputText @bind-Value="_formModel.Name" id="service-name" placeholder="e.g. Breakfast" />
                            <ValidationMessage For="() => _formModel.Name" class="help is-danger" />
                        </label>

                        <label class="rate-create-field">
                            <span>Price (€)</span>
                            <InputNumber @bind-Value="_formModel.Price" id="service-price" step="0.50" min="0" />
                            <ValidationMessage For="() => _formModel.Price" class="help is-danger" />
                        </label>

                        <SelectField Label="Billing cadence">
                            <ChildContent>
                                <InputSelect @bind-Value="_formModel.Cadence" id="service-cadence">
                                    <option value="@ChargeCadence.PerNight">Per night</option>
                                    <option value="@ChargeCadence.Once">Once (per booking)</option>
                                </InputSelect>
                            </ChildContent>
                            <Validation>
                                <ValidationMessage For="() => _formModel.Cadence" class="help is-danger" />
                            </Validation>
                        </SelectField>

                        <SelectField Label="Charging basis">
                            <ChildContent>
                                <InputSelect @bind-Value="_formModel.IsPerPerson" id="service-target">
                                    <option value="true">Per person (multiplied by guests)</option>
                                    <option value="false">Per booking (flat rate)</option>
                                </InputSelect>
                            </ChildContent>
                            <Validation>
                                <ValidationMessage For="() => _formModel.IsPerPerson" class="help is-danger" />
                            </Validation>
                        </SelectField>

                        <label class="rate-create-field rate-field-full">
                            <span>Description</span>
                            <InputText @bind-Value="_formModel.Description" id="service-description" placeholder="Optional details..." />
                            <ValidationMessage For="() => _formModel.Description" class="help is-danger" />
                        </label>
                    </div>

                    @if (_formModel is ExtraServiceRequest.Edit editModel)
                    {
                        <label class="checkbox rate-refundable">
                            <InputCheckbox @bind-Value="editModel.IsActive" id="service-active" />
                            Active (available for bookings and rates)
                        </label>
                    }

                    @if (_formError is not null)
                    {
                        <p class="notification is-danger is-light mt-3">@_formError</p>
                    }

                    <div class="rate-create-actions">
                        <Button Type="submit" IsDisabled="_isSaving">Save extra service</Button>
                        <Button Variant="ButtonVariant.Secondary" OnClick="CloseForm">Cancel</Button>
                    </div>
                </EditForm>
            </section>
        }
    }
</div>
