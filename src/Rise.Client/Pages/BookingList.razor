@page "/admin/booking-list"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Shared.Identity

<PageTitle>Bookings</PageTitle>

<h1 class="title">Bookings</h1>

@if (_bookings is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="box">
        <h2 class="subtitle mb-4">All bookings</h2>

        @if (_errorMessage is not null)
        {
            <p class="notification is-danger is-light">@_errorMessage</p>
        }
        else if (!_bookings.Any())
        {
            <p class="has-text-grey">No bookings yet.</p>
        }
        else
        {
            <table class="table is-fullwidth is-striped is-hoverable booking-list-table">
                <thead>
                    <tr>
                        <th>Booking #</th>
                        <th>Guest</th>
                        <th>Room(s)</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in _bookings)
                    {
                        <tr @key="booking.Id" class="booking-list-row">
                            <td class="booking-list-number">@booking.BookingNumber</td>
                            <td class="booking-list-guest">@booking.GuestName</td>
                            <td class="booking-list-rooms">@string.Join(", ", booking.RoomNumbers)</td>
                            <td class="booking-list-checkin">@FormatDate(booking.CheckIn)</td>
                            <td class="booking-list-checkout">@FormatDate(booking.CheckOut)</td>
                            <td class="booking-list-status">
                                @if (booking.Status == "Paid")
                                {
                                    <span class="tag is-primary is-light">Paid</span>
                                }
                                else
                                {
                                    <span class="tag is-warning is-light">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* Pagination controls *@
            <nav class="pagination is-centered mt-4" role="navigation" aria-label="pagination">
                <button class="pagination-previous"
                        disabled="@(_currentPage <= 1)"
                        @onclick="PreviousPageAsync">
                    Previous
                </button>
                <button class="pagination-next"
                        disabled="@(_currentPage >= TotalPages)"
                        @onclick="NextPageAsync">
                    Next
                </button>
                <ul class="pagination-list">
                    @for (var page = 1; page <= TotalPages; page++)
                    {
                        var p = page; // capture for the lambda
                        <li>
                            <button class="pagination-link @(p == _currentPage ? "is-current" : "")"
                                    aria-label="Page @p"
                                    aria-current="@(p == _currentPage ? "page" : null)"
                                    @onclick="() => GoToPageAsync(p)">
                                @p
                            </button>
                        </li>
                    }
                </ul>
            </nav>
            <p class="has-text-grey has-text-centered is-size-7 mt-2">
                Showing @_bookings.Count() of @_totalCount booking@(_totalCount == 1 ? "" : "s")
            </p>
        }
    </div>
}
