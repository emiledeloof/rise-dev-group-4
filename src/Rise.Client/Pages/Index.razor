@inherits LocalizedComponentBase
@page "/"

<PageTitle>Stazzu La Vigna di Maria</PageTitle>

@* ---------- hero, photos of the estate fading one after the other behind the logo ---------- *@
<div class="hero">
    @* slideshow in css only, see Index.razor.css, each photo starts SlideSeconds after the previous one *@
    @* decorative, so hidden from screen readers *@
    <div class="hero-slides" aria-hidden="true">
        @for (var i = 0; i < HeroPhotos.Length; i++)
        {
            <img class="hero-slide" src="@HeroPhotos[i]" alt="" style="animation-delay: @(i * SlideSeconds)s" />
        }
    </div>

    <div class="hero-content">
        <img class="hero-logo" src="images/home/logo-white.png" alt="Stazzu La Vigna di Maria" />
        <h1 class="hero-title">@Text["HeroTitle"]</h1>

        @* shared search bar, same as on the search and results pages, goes to the results page *@
        @* TODO: guests and rooms fields of the mockup, when a story asks for them *@
        <SearchBar MaxRooms="@(_totalCount > 0 ? _totalCount : null)" MaxGuests="@(_totalCapacity > 0 ? _totalCapacity : null)" />
    </div>
</div>

@* ---------- the estate ---------- *@
<section class="home-section">
    <div class="home-inner estate">
        <div class="estate-text">
            <span class="eyebrow">@Text["TheEstateEyebrow"]</span>
            <h2>@Text["ManorFarmTitle"]</h2>
            <p class="home-muted">
                Stazzu La Vigna di Maria stands on 2.4 hectares of gardens, two small vineyards and a wood
                with granite rocks and caves. In one of those caves we found a small statue of Mary, which
                gave the estate its name.
            </p>
            <Button Variant="ButtonVariant.Secondary" Href="estate">@Text["DiscoverTheEstate"]</Button>
        </div>
        @* photos of the estate, same glass arrows as the room cards, a click shows the photo large *@
        <div class="estate-photo">
            <PhotoCarousel Photos="@EstatePhotos" Alt="The estate of Stazzu La Vigna di Maria" Zoomable="true" />
        </div>
    </div>
</section>

@* ---------- rooms ---------- *@
<section class="home-section home-section-alt">
    <div class="home-inner">
        <span class="eyebrow">@Text["OurRoomsEyebrow"]</span>
        <h2>@Text["ThreeRoomsTitle"]</h2>

        @* nothing while loading so no placeholder data flashes, a msg with a way on when there are no rooms *@
        @if (_isLoading)
        {
            @* empty on purpose, the api answers fast and a spinner would flash *@
        }
        else if (_errorMessage is not null)
        {
            <p class="home-muted rooms-empty">
                @_errorMessage <a class="home-link" href="search">@Text["SearchRooms"] <i class="fas fa-arrow-right"></i></a>
            </p>
        }
        else
        {
            @* at most FeaturedRoomsCount cards, see Index.razor.cs *@
            <div class="card-grid">
                @foreach (var room in _rooms)
                {
                    <article class="room-card">
                        @* photos of the room, the glass arrows show the next or previous one *@
                        <PhotoCarousel Photos="@room.PhotoUrls" Alt="@room.Name" />
                        <div class="room-card-body">
                            <h3>@room.Name</h3>

                            @* short text, cut to 2 lines in the css, the full text is on the detail page *@
                            @if (!string.IsNullOrWhiteSpace(room.Description))
                            {
                                <p class="room-card-description home-muted">@room.Description</p>
                            }

                            @* no price line for a room without a rate, never a €0 *@
                            @if (room.FromPrice is { } fromPrice)
                            {
                                <p class="room-card-price home-small home-muted">@Text["From"] €@fromPrice.ToString("0") @Text["PerNight"] · @Text["InclVat"]</p>
                            }

                            <a class="home-link" href="rooms/@room.Id">@Text["ViewRoom"] <i class="fas fa-arrow-right"></i></a>
                        </div>
                    </article>
                }
            </div>

            @* only when the db has more rooms than the cards *@
            @if (HasMoreRooms)
            {
                <a class="home-link rooms-all" href="rooms">@Text["SeeAllRooms"] <i class="fas fa-arrow-right"></i></a>
            }
        }
    </div>
</section>

@* ---------- reviews ---------- *@
<section class="home-section">
    <div class="home-inner">
        <span class="eyebrow">@Text["ReviewsEyebrow"]</span>
        <h2>@Text["WhatOurGuestsSay"]</h2>

        <div class="card-grid">
            @foreach (var review in ReviewList)
            {
                <article class="review-card">
                    <div class="review-stars" aria-label="@Text["FiveOutOfFiveStars"]">★★★★★</div>
                    <p>@review.Text</p>
                    <p class="home-small home-muted">@review.Author · @review.Source</p>
                </article>
            }
        </div>

        <a class="home-link review-all" href="reviews">@Text["ReadAllReviewsOnGoogle"] <i class="fas fa-arrow-right"></i></a>
    </div>
</section>
