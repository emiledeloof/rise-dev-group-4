@page "/admin/amenities"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Shared.Amenities
@using Rise.Shared.Common
@using Rise.Shared.Identity
@* admin catalogue of the amenities, assigned to the room types on the room types page, styles in Amenities.razor.css *@

<PageTitle>Amenities</PageTitle>
<UnsavedChangesGuard @ref="_guard" IsDirty="IsDirty" />

<div class="page">
    <div class="amenity-heading">
        <div>
            <h1 class="title">Amenities</h1>
            <p class="amenity-intro">A new amenity is shown to guests once it is ticked on a room type.</p>
        </div>
        <Button OnClick="OpenCreateFormAsync">New amenity</Button>
    </div>

    @if (_amenities is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (_message is not null)
        {
            <p class="notification @(_messageIsError ? "is-danger" : "is-success") is-light" role="status">@_message</p>
        }

        <div class="box amenity-list">
            @* ! no empty state after a failed load, the list is not really empty *@
            @if (_amenities.Count == 0 && !_loadFailed)
            {
                <p class="amenity-muted">No amenities yet.</p>
            }
            else
            {
                @* a table from tablets on, one card per amenity on phones, see the css *@
                <table class="amenity-table">
                    <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Translations</th>
                        <th scope="col">Room types</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="is-sr-only">Actions</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var amenity in _amenities)
                    {
                        <tr @key="amenity.Id" class="amenity-row @(amenity.IsActive ? "" : "is-inactive")">
                            <td class="amenity-name">
                                <span class="amenity-icon" aria-hidden="true"><i class="fas @amenity.Icon"></i></span>
                                <span>@EnglishName(amenity)</span>
                            </td>
                            <td class="amenity-translations" data-label="Translations">
                                @TranslatedCount(amenity) / @Languages.Supported.Count
                            </td>
                            <td class="amenity-room-types" data-label="Room types">
                                @(amenity.RoomTypeNames.Count == 0 ? "—" : string.Join(", ", amenity.RoomTypeNames))
                            </td>
                            <td class="amenity-status" data-label="Status">
                                <span class="tag @(amenity.IsActive ? "is-success" : "is-warning") is-light">@(amenity.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="amenity-actions">
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => OpenEditFormAsync(amenity)">Edit</Button>
                                @if (amenity.IsActive)
                                {
                                    <Button Variant="ButtonVariant.Secondary" OnClick="() => ChangeActiveAsync(amenity, false)" Class="amenity-deactivate">Deactivate</Button>
                                }
                                else
                                {
                                    <Button Variant="ButtonVariant.Secondary" OnClick="() => ChangeActiveAsync(amenity, true)" Class="amenity-activate">Activate</Button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        @* one form for create and edit, the type of the model decides which api is called *@
        @if (_formModel is not null)
        {
            <section class="amenity-panel" aria-labelledby="amenity-form-heading">
                <h3 id="amenity-form-heading">@(_formModel is AmenityRequest.Edit ? "Edit amenity" : "New amenity")</h3>

                <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                    <FluentValidationValidator />

                    <fieldset class="amenity-fieldset">
                        <legend>Name</legend>
                        <div class="amenity-names">
                            @foreach (var language in Languages.Supported)
                            {
                                var lang = language;
                                <label class="amenity-field">
                                    <span class="@(lang == Languages.Default ? "is-required" : "")">
                                        @Languages.Names[lang]@(lang == Languages.Default ? " (required)" : "")
                                    </span>
                                    @* ! plain input, InputText cannot bind to a dictionary entry *@
                                    <input id="amenity-name-@lang" lang="@lang" maxlength="100"
                                           value="@_formModel.Names.GetValueOrDefault(lang)"
                                           @oninput="e => _formModel.Names[lang] = e.Value?.ToString()" />
                                </label>
                            }
                        </div>
                        <ValidationMessage For="() => _formModel.Names" class="help is-danger" />
                        <p class="amenity-help">An empty language shows the English name to the guest.</p>
                    </fieldset>

                    <label class="amenity-field amenity-icon-field">
                        <span class="is-required">Icon (required)</span>
                        <span class="amenity-icon-input">
                            <span class="amenity-icon amenity-icon-preview" aria-hidden="true"><i class="fas @_formModel.Icon"></i></span>
                            <InputText @bind-Value="_formModel.Icon" @bind-Value:after="StateHasChanged" id="amenity-icon" list="amenity-icon-options" placeholder="fa-wifi" />
                        </span>
                        <datalist id="amenity-icon-options">
                            @foreach (var icon in SuggestedIcons)
                            {
                                <option value="@icon"></option>
                            }
                        </datalist>
                        <ValidationMessage For="() => _formModel.Icon" class="help is-danger" />
                        <span class="amenity-help">A Font Awesome name, see fontawesome.com/icons.</span>
                    </label>

                    @if (_formError is not null)
                    {
                        <p class="notification is-danger is-light" role="alert">@_formError</p>
                    }

                    <div class="amenity-form-actions">
                        <Button Type="submit" IsLoading="_isSaving" Class="amenity-save">Save</Button>
                        <Button Variant="ButtonVariant.Secondary" OnClick="CancelFormAsync" Class="amenity-cancel">Cancel</Button>
                    </div>
                </EditForm>
            </section>
        }
    }
</div>
