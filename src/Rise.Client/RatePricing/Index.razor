@page "/admin/rate-pricing"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Shared.Identity
@* admin page to change the price and the min nb of nights of each rate, logic in Index.razor.cs *@

<PageTitle>Rate pricing</PageTitle>

<div class="page">
    <h1 class="title">Rate pricing</h1>

    @if (rates is null)
    {
        @* api still answering *@
        <p>Loading...</p>
    }
    else if (errorMessage is not null)
    {
        @* the list could not be loaded, no table to show *@
        <p class="notification is-danger is-light">@errorMessage</p>
    }
    else
    {
        @* one row per rate, @key helps blazor keep each row when the list is reloaded after a save *@
        <table class="table">
            <thead>
                <tr><th>Room</th><th>Rate</th><th>Price per night</th><th>Min nights</th><th>Cancellation</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var rate in rates)
                {
                    <tr @key="rate.RateId">
                        <td>@rate.RoomName</td>
                        <td>@rate.RateName</td>
                        <td>@FormatPrice(rate.PricePerNight)</td>
                        <td>@rate.MinNights</td>
                        <td>@FormatPolicy(rate)</td>
                        <td>
                            <Button Variant="ButtonVariant.Secondary" OnClick="() => StartEdit(rate)">Edit</Button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* what the last save changed, hidden again when an other edit starts *@
        @if (successMessage is not null)
        {
            <p class="notification is-success is-light">@successMessage</p>
        }

        @* edit form of one rate, only open after a click on edit *@
        @if (editModel is not null)
        {
            @* same validator as the server, SaveAsync only runs when every rule passes *@
            <EditForm Model="editModel" OnValidSubmit="SaveAsync">
                <FluentValidationValidator />

                <div class="field">
                    <label class="label" for="price">Price per night (€)</label>
                    <InputNumber @bind-Value="editModel.PricePerNight" id="price" class="input" />
                    <ValidationMessage For="() => editModel.PricePerNight" class="help is-danger" />
                </div>

                <div class="field">
                    <label class="label" for="min-nights">Minimum nights</label>
                    <InputNumber @bind-Value="editModel.MinNights" id="min-nights" class="input" />
                    <ValidationMessage For="() => editModel.MinNights" class="help is-danger" />
                </div>

                @* checked = refundable, unchecked = non refundable *@
                <div class="field">
                    <label class="checkbox">
                        <InputCheckbox @bind-Value="editModel.IsRefundable" />
                        Refundable
                    </label>
                </div>

                @* refund values only for a refundable rate, they show and hide as soon as the box is clicked *@
                @if (editModel.IsRefundable)
                {
                    <div class="field">
                        <label class="label" for="full-refund-days">Full refund up to (days before arrival)</label>
                        <InputNumber @bind-Value="editModel.FullRefundDays" id="full-refund-days" class="input" />
                        <ValidationMessage For="() => editModel.FullRefundDays" class="help is-danger" />
                    </div>

                    <div class="field">
                        <label class="label" for="partial-refund-days">Partial refund up to (days before arrival)</label>
                        <InputNumber @bind-Value="editModel.PartialRefundDays" id="partial-refund-days" class="input" />
                        <ValidationMessage For="() => editModel.PartialRefundDays" class="help is-danger" />
                    </div>

                    <div class="field">
                        <label class="label" for="partial-refund-percent">Partial refund (%)</label>
                        <InputNumber @bind-Value="editModel.PartialRefundPercent" id="partial-refund-percent" class="input" />
                        <ValidationMessage For="() => editModel.PartialRefundPercent" class="help is-danger" />
                    </div>
                }

                @* the api refused or failed the save *@
                @if (saveErrorMessage is not null)
                {
                    <p class="notification is-danger is-light">@saveErrorMessage</p>
                }

                <Button Type="submit">Save</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="CancelEdit">Cancel</Button>
            </EditForm>
        }
    }
</div>
