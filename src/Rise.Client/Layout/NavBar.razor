<nav class="navbar site-navbar" role="navigation" aria-label="main navigation">                                             
      <!-- LEFT: Brand Name -->                                                                                                 
      <div class="navbar-brand">                                                                                                
        <a class="navbar-item site-brand" href="/">                                                                             
          @* emblem and name of the real logo, cut from the full logo, see wwwroot/images/logo *@
          <img class="site-brand-emblem" src="images/logo/emblem.png" alt="" />
          <img class="site-brand-name" src="images/logo/la-vigna-di-maria.png" alt="Stazzu La Vigna di Maria" />
        </a>                                                                                                                    
      </div>                                                                                                                    
                                                                                                                                
      <div id="navbarBasicExample" class="navbar-menu">                                                                         
        <!-- Empty navbar-start pushes everything to navbar-end -->                                                             
        <div class="navbar-start"></div>                                                                                        
                                                                                                                                
        <!-- RIGHT: Navigation links, Language, and Book a Room button -->                                                      
        <div class="navbar-end">                                                                                                
          <NavLink class="navbar-item" href="rooms">@Text["Rooms"]</NavLink>
          <NavLink class="navbar-item" href="estate">@Text["TheEstate"]</NavLink>
          <NavLink class="navbar-item" href="reviews">@Text["Reviews"]</NavLink>
          <NavLink class="navbar-item" href="contact">@Text["Contact"]</NavLink>
                                                                                                                                
          <!-- Language Button / Indicator -->                                                                                  
          <div class="navbar-item">
            <LanguageSelector />
          </div>                                                                                                                
                                                                                                                                
          <!-- Green Book a Room Button (ButtonVariant.Primary uses --color-primary: olive green) -->                           
          <div class="navbar-item">                                                                                             
            <Button Variant="ButtonVariant.Primary" Href="search">@Text["BookARoom"]</Button>
          </div>                                                                                                                
        </div>                                                                                                                  
      </div>                                                                                                                    
    </nav>

@code {
    [Inject]
    private Toolbelt.Blazor.I18nText.I18nText I18nText { get; set; } = null!;

    private AppText Text { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Text = await I18nText.GetTextTableAsync<AppText>(this);
    }
}
