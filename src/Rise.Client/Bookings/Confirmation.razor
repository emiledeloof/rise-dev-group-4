@page "/booking/confirmation"

<PageTitle>Booking Confirmation</PageTitle>

<div class="confirmation-page">
    <header class="confirmation-header">
        <span class="confirmation-status">Confirmed</span>
        <p class="booking-number">Booking @bookingNumber</p>
        <h1 class="title">Thank you, your stay is confirmed</h1>
        <p class="booking-email">
            A confirmation email is on its way to @guestEmail.
        </p>
    </header>

    <section class="box booking-details" aria-labelledby="booking-details-title">
        <h2 id="booking-details-title" class="booking-details-title">
            Booking details
        </h2>

        <dl class="booking-details-list">
            <div class="booking-detail-row">
                <dt>Booking ID</dt>
                <dd>@bookingNumber</dd>
            </div>
            <div class="booking-detail-row">
                <dt>Stay</dt>
                <dd>
                    @checkInDate.ToString("dd MMM yyyy") –
                    @checkOutDate.ToString("dd MMM yyyy") · 
                    @numberOfNights @(numberOfNights == 1 ? "night" : "nights")
                </dd>
            </div>
            <div class="booking-detail-row">
                <dt>Room</dt>
                <dd>@roomName · @guestCount guests</dd>
            </div>
            <div class="booking-detail-row">
                <dt>Rate</dt>
                <dd>@FormatAmount(roomRate)</dd>
            </div>
        </dl>

        <p class="cancellation-note">Cancellation details go here.</p>
    </section>
    
    <div class="buttons">
        <Button Variant="ButtonVariant.Secondary" Href="">Back to home</Button>
    </div>
    
</div>



@code {
    private string bookingNumber = "XYZ123";
    protected DateOnly checkInDate = DateOnly.FromDateTime(DateTime.Now.AddDays(7));
    private DateOnly checkOutDate = DateOnly.FromDateTime(DateTime.Now.AddDays(10));
    private int numberOfNights => (checkOutDate.DayNumber - checkInDate.DayNumber);
    private int guestCount = 2;
    private string guestName = "John Doe";
    private string guestEmail = "john.doe@example.com";
    private string roomName = "Deluxe Suite";
    private decimal roomRate = 100;
    private string adminEmail = "admin@example.com";
    private string adminPhone = "+1 234 567 890";
}
