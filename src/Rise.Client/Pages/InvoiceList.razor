@page "/admin/invoice-list"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Client.Common
@using Rise.Shared.Identity

<PageTitle>Invoices</PageTitle>

<div class="page">
    <h1 class="title">Invoices</h1>

    @if (invoices is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @* styled after the bill card of the settlement mockup, styles in InvoiceList.razor.css *@
        <div class="box invoice-list">
            <h2 class="invoice-list-title">Payments</h2>

            @if (errorMessage is not null)
            {
                <p class="notification is-danger is-light">@errorMessage</p>
            }
            else if (!invoices.Any())
            {
                <p class="invoice-muted">No invoices yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var invoice in invoices)
                    {
                        @* TODO: add the stripe invoice download with the download task *@
                        <li @key="invoice.Id" class="invoice-row">
                            <div>
                                <p class="invoice-booking">
                                    <a class="invoice-booking-link" href="admin/bookings/@invoice.BookingId">Booking @invoice.BookingNumber</a> · @invoice.GuestName
                                </p>
                                <p class="invoice-muted">
                                    @if (invoice.IsPaid)
                                    {
                                        @(invoice.InvoiceNumber is null ? "" : $"{invoice.InvoiceNumber} · ")
                                        @($"Paid {Format.Date(invoice.PaidAt!.Value)}")
                                    }
                                    else
                                    {
                                        <text>Awaiting payment</text>
                                    }
                                </p>
                                @if (invoice.IsPaid && invoice.StripePaymentIntent is not null)
                                {
                                    <p class="invoice-muted invoice-stripe">
                                        @if (invoice.CardLast4 is not null)
                                        {
                                            <span>@Format.Card(invoice.CardBrand, invoice.CardLast4)</span>
                                        }
                                        @if (invoice.StripeReceiptUrl is not null)
                                        {
                                            <a href="@invoice.StripeReceiptUrl" target="_blank" rel="noopener">Stripe receipt ↗</a>
                                        }
                                        <a href="@StripeDashboardUrl(invoice.StripePaymentIntent)" target="_blank" rel="noopener">View in Stripe ↗</a>
                                    </p>
                                }
                            </div>
                            <div class="invoice-amount">
                                <span>@Format.Amount(invoice.Amount)</span>
                                @if (invoice.IsPaid)
                                {
                                    <span class="tag is-primary is-light">Paid</span>
                                    @if (invoice.StripePaymentIntent is not null)
                                    {
                                        <span class="tag is-info is-light">via Stripe</span>
                                    }
                                }
                                else
                                {
                                    <span class="tag is-warning is-light">Open</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
}
</div>