@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Shared.Identity
@using Rise.Shared.Bookings

<PageTitle>Booking matrix</PageTitle>

<div class="matrix-page">
    <div class="matrix-header">
        <h1 class="matrix-title">Booking matrix</h1>

        <div class="matrix-header-controls">
            <div class="matrix-nav">
                <button class="matrix-nav-btn" @onclick="PreviousWindowAsync">‹</button>
                <div class="matrix-window-box">@WindowLabel</div>
                <button class="matrix-nav-btn" @onclick="NextWindowAsync">›</button>
            </div>
            
            @*<div class="matrix-top-actions">
                <button class="action-btn outline-btn" type="button">Open or close rooms</button>
                <button class="action-btn outline-btn" type="button">Print poster</button>
            </div>*@
        </div>
    </div>

    <div class="matrix-legend">
        <span class="legend-chip available">Available</span>
        <span class="legend-chip occupied">Occupied</span>
        <span class="legend-chip temporary">Temporary</span>
    </div>

    @if (_matrix is null && _errorMessage is null)
    {
        <p><em>Loading…</em></p>
    }
    else if (_errorMessage is not null)
    {
        <p class="notification is-danger is-light">@_errorMessage</p>
    }
    else if (_matrix is not null && _matrix.Rows.Count == 0)
    {
        <div class="matrix-empty-state">
            <p class="empty-state-title">No rooms found</p>
            <p class="empty-state-body">There are no rooms configured for this property yet.</p>
        </div>
    }
    else if (_matrix is not null)
    {
        <div class="matrix-scroll">
            <div class="matrix-grid" style="--window-days:@_matrix.WindowDays">

                @* ── header row ── *@
                <div class="matrix-cell matrix-room-header">Room</div>
                @foreach (var day in Days)
                {
                    <div class="matrix-cell matrix-day-header @(IsToday(day) ? "is-today" : "")">
                        <span class="day-name">@day.ToString("ddd")</span>
                        <span class="day-num @(IsToday(day) ? "today-circle" : "")">@day.Day</span>
                    </div>
                }

                @* ── one section/row per room ── *@
                @foreach (var row in _matrix.Rows)
                {
                    @* Category / Room label banner *@
                    <div class="matrix-category-banner">
                        <span class="category-name">Room #@row.RoomId</span>
                    </div>

                    @* Room row: left room cell + timeline track *@
                    <div class="matrix-cell matrix-room-label">
                        <span class="room-number-text">@row.RoomName.ToUpperInvariant()</span>
                    </div>

                    <div class="matrix-timeline-track">
                        <div class="track-flat-grid" style="--window-days:@_matrix.WindowDays">
                            @foreach (var cellItem in GetRowCells(row))
                            {
                                var cssClass = cellItem.Status switch
                                {
                                    CellStatus.Occupied  => "matrix-cell-occupied",
                                    CellStatus.Temporary => "matrix-cell-temporary",
                                    _                    => "matrix-cell-available",
                                };
                                @if (cellItem.Booking is not null)
                                {
                                    <div class="@cssClass"
                                         style="grid-column: span @cellItem.ColSpan;"
                                         @onmouseenter="e => ShowPopup(cellItem.Booking.Id, e.ClientX, e.ClientY)"
                                         @onmouseleave="HidePopup">
                                        <span class="cell-guest-name">@cellItem.Booking.GuestName</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="@cssClass" style="grid-column: span @cellItem.ColSpan;"></div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* New booking button
        <div class="matrix-bottom-actions">
            <button class="btn-new-booking" type="button">New booking</button>
        </div>*@
    }

    <BookingPopup BookingId="_popupBookingId" X="_popupX" Y="_popupY" />
</div>

