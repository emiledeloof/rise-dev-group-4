@page "/admin/promotion-codes"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using System.ComponentModel.DataAnnotations
@using Rise.Shared.PromotionCodes
@using Rise.Shared.Identity

<PageTitle>Promotion codes</PageTitle>

<div class="page promotion-codes-page">
    <div class="promotion-codes-heading">
        <h1 class="title">Promotion codes</h1>
        <Button OnClick="ToggleCreateForm" Variant="ButtonVariant.Primary">
            @(IsCreateFormOpen ? "Close" : "New promotion code")
        </Button>
    </div>

    @if (IsCreateFormOpen)
    {
        <EditForm Model="_model" OnValidSubmit="SavePromotionCode">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <section class="promotion-code-form box" aria-labelledby="promotion-code-form-title">
                <h2 id="promotion-code-form-title">@(_model.Code is null ? "New promotion code" : _model.Code)</h2>

                <div class="promotion-code-fields">
                    <div class="promotion-code-field">
                        <label for="promotion-code">Code</label>
                        <InputText id="promotion-code" @bind-Value="_model.Code" />
                        <ValidationMessage For="() => _model.Code" />
                    </div>

                    <div class="promotion-code-field">
                        <label for="discount-type">Discount type</label>
                        <InputSelect id="discount-type" @bind-Value="_model.DiscountType">
                            <option value="Percentage">Percentage</option>
                            <option value="Fixed">Fixed amount</option>
                        </InputSelect>
                    </div>

                    <div class="promotion-code-field">
                        <label for="discount-value">Value</label>
                        <InputNumber id="discount-value" @bind-Value="_model.Value" />
                        <ValidationMessage For="() => _model.Value" />
                    </div>

                    <div class="promotion-code-field">
                        <label for="valid-from">Valid from–to</label>
                        <div class="promotion-code-date-range">
                            <InputDate id="valid-from" @bind-Value="_model.ValidFrom" />
                            <span aria-hidden="true">–</span>
                            <InputDate id="valid-to" @bind-Value="_model.ValidTo" />
                        </div>
                        <ValidationMessage For="() => _model.ValidFrom" />
                        <ValidationMessage For="() => _model.ValidTo" />
                    </div>

                    <div class="promotion-code-field promotion-code-field-full">
                        <label for="email-restriction">Restrict to one e-mail address <span>(optional)</span></label>
                        <InputText id="email-restriction"
                                   @bind-Value="_model.EmailRestriction"
                                   placeholder="Leave empty for anyone" />
                        <ValidationMessage For="() => _model.EmailRestriction" />
                    </div>

                    <div class="promotion-code-field promotion-code-field-full">
                        <label for="applies-to">Applies to</label>
                        <InputSelect id="applies-to" @bind-Value="_model.AppliesTo">
                            <option value="NonRefundable">Non-refundable rate only</option>
                            <option value="AllRates">All rates</option>
                        </InputSelect>
                    </div>
                </div>

                <label class="promotion-code-active">
                    <InputCheckbox @bind-Value="_model.IsActive" />
                    <span>Active</span>
                </label>

                <p class="promotion-code-notice">
                    Discounts and <strong>promotion codes</strong> are calculated on the amount excluding VAT.
                </p>

                <div class="promotion-code-actions">
                    <button class="button is-primary promotion-code-save" type="submit" disabled="@_isSaving">
                        @(_isSaving ? "Saving..." : "Save promotion code")
                    </button>
                    <button class="button is-light" type="button" @onclick="CloseCreateForm">Cancel</button>
                </div>
                @if (_errorMessage is not null)
                {
                    <p class="notification is-danger is-light mt-3">@_errorMessage</p>
                }
            </section>
        </EditForm>
    }
</div>

@code {
    [Inject]
    private IPromotionCodeService PromotionCodeService { get; set; } = default!;

    private bool IsCreateFormOpen { get; set; }
    private PromotionCodeFormModel _model = new();
    private string? _errorMessage;
    private bool _isSaving;

    private void ToggleCreateForm()
    {
        if (IsCreateFormOpen)
        {
            CloseCreateForm();
            return;
        }

        _model = new PromotionCodeFormModel();
        _errorMessage = null;
        IsCreateFormOpen = true;
    }

    private void CloseCreateForm()
    {
        IsCreateFormOpen = false;
        _model = new PromotionCodeFormModel();
        _errorMessage = null;
    }

    private async Task SavePromotionCode()
    {
        if (_isSaving || _model.ValidFrom is null || _model.ValidTo is null)
            return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var result = await PromotionCodeService.CreateAsync(new PromotionCodeRequest.Create
            {
                Code = _model.Code ?? string.Empty,
                DiscountType = Enum.Parse<PromotionCodeDiscountType>(_model.DiscountType),
                Value = _model.Value,
                ValidFrom = DateOnly.FromDateTime(_model.ValidFrom.Value),
                ValidTo = DateOnly.FromDateTime(_model.ValidTo.Value),
                EmailRestriction = _model.EmailRestriction,
                AppliesTo = Enum.Parse<PromotionCodeAppliesTo>(_model.AppliesTo),
                IsActive = _model.IsActive,
            });

            if (result.IsSuccess)
            {
                CloseCreateForm();
                return;
            }

            _errorMessage = string.Join(" ", result.Errors);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class PromotionCodeFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Code is required.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Code must contain between 2 and 50 characters.")]
        [RegularExpression("^[A-Za-z0-9_-]+$", ErrorMessage = "Code may contain only letters, numbers, hyphens and underscores.")]
        public string? Code { get; set; }

        public string DiscountType { get; set; } = "Percentage";

        [Range(0.01, 100000, ErrorMessage = "Value must be greater than 0.")]
        public decimal Value { get; set; } = 10;

        [Required(ErrorMessage = "A start date is required.")]
        public DateTime? ValidFrom { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "An end date is required.")]
        public DateTime? ValidTo { get; set; } = DateTime.Today.AddMonths(1);

        [EmailAddress(ErrorMessage = "Enter a valid e-mail address.")]
        public string? EmailRestriction { get; set; }

        public string AppliesTo { get; set; } = "NonRefundable";
        public bool IsActive { get; set; } = true;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (DiscountType == "Percentage" && Value > 100)
            {
                yield return new ValidationResult(
                    "A percentage discount cannot exceed 100%.",
                    [nameof(Value)]);
            }

            if (ValidFrom is not null && ValidFrom.Value.Date < DateTime.Today)
            {
                yield return new ValidationResult(
                    "Start date cannot be in the past.",
                    [nameof(ValidFrom)]);
            }

            if (ValidFrom is not null && ValidTo is not null && ValidTo.Value.Date < ValidFrom.Value.Date)
            {
                yield return new ValidationResult(
                    "End date must be on or after the start date.",
                    [nameof(ValidTo)]);
            }
        }
    }
}
