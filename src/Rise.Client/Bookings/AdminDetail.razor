@page "/admin/bookings/{BookingId:int}"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Client.Common
@using Rise.Shared.Bookings
@using Rise.Shared.Identity
@* admin booking detail, opened from the booking list and the invoice list, styles in AdminDetail.razor.css *@
@* missing values show "Not provided", never made up data *@

<PageTitle>@(_booking is null ? "Booking" : $"Booking {_booking.BookingNumber}")</PageTitle>

<div class="page booking-detail">
    <a class="booking-detail-back" href="admin/booking-list">
        <i class="fas fa-arrow-left" aria-hidden="true"></i><span>All bookings</span>
    </a>

    @if (_isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (_booking is null)
    {
        @* unknown or deleted booking, or the api call failed, msg set in the code-behind *@
        <div class="box booking-detail-card booking-detail-empty-state">
            <p class="booking-detail-error">@_errorMessage</p>
            <Button Variant="ButtonVariant.Secondary" Href="admin/booking-list" Class="mt-3">Back to the bookings</Button>
        </div>
    }
    else
    {
        @* ---------- header, booking number and status ---------- *@
        <header class="booking-detail-header">
            <div>
                <span class="eyebrow">Booking</span>
                <h1 class="booking-detail-number">@_booking.BookingNumber</h1>
                <p class="booking-detail-muted booking-detail-created">Booked on @Format.Date(_booking.CreatedAt)</p>
            </div>
            <span class="booking-detail-status">
                @if (_booking.Status == BookingStatus.Cancelled)
                {
                    <span class="tag is-danger is-medium booking-detail-cancelled-tag">
                        <i class="fas fa-ban" aria-hidden="true"></i>
                        <span>Cancelled</span>
                    </span>
                }
                else if (_booking.Status == BookingStatus.Paid)
                {
                    <span class="tag is-primary is-light is-medium">Paid</span>
                }
                else
                {
                    <span class="tag is-warning is-light is-medium">Pending</span>
                }
                @if (CancelledRooms.Count > 0 && ActiveRooms.Count > 0)
                {
                    <span class="tag is-danger is-light is-medium booking-detail-partial-tag">@CancelledRooms.Count of @_booking.Rooms.Count rooms cancelled</span>
                }
            </span>
        </header>

        @if (_successMessage is not null)
        {
            <div class="booking-detail-notice booking-detail-cancel-success" role="status">
                <i class="fas fa-circle-check" aria-hidden="true"></i>
                <p>@_successMessage</p>
            </div>
        }

        <div class="booking-detail-layout">
            <div class="booking-detail-main">
                @* ---------- cancellations per room, the booking and its original terms stay visible below ---------- *@
                @if (CancelledRooms.Count > 0)
                {
                    <section class="box booking-detail-card booking-detail-cancellation">
                        <span class="eyebrow">Cancellation</span>

                        <ul>
                            @foreach (var room in CancelledRooms)
                            {
                                <li @key="room.BookingRoomId" class="booking-detail-cancelled-room">
                                    <p class="booking-detail-room-name">Room @room.RoomNumber · @room.RoomName</p>
                                    <dl class="booking-detail-facts">
                                        <div>
                                            <dt><i class="fas fa-calendar-xmark" aria-hidden="true"></i>Cancelled on</dt>
                                            <dd class="booking-detail-cancelled-at">@Format.Date(room.Cancellation!.CancelledAt)</dd>
                                        </div>
                                        <div>
                                            <dt><i class="fas fa-comment" aria-hidden="true"></i>Reason</dt>
                                            <dd class="booking-detail-cancel-reason">@room.Cancellation.Reason</dd>
                                        </div>
                                        <div>
                                            <dt><i class="fas fa-rotate-left" aria-hidden="true"></i>Refund</dt>
                                            <dd class="booking-detail-refund">@(room.Cancellation.RefundAmount > 0 ? Format.Amount(room.Cancellation.RefundAmount) : "No refund")</dd>
                                        </div>
                                    </dl>
                                </li>
                            }
                        </ul>

                        @if (_booking.RefundedAmount > 0)
                        {
                            <p class="booking-detail-refunded-total">
                                <span>Total refunds</span>
                                <span class="booking-detail-refunded-amount">@Format.Amount(_booking.RefundedAmount)</span>
                            </p>
                            <p class="booking-detail-refund-note">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                The website does not refund automatically, pay the refund back to the guest yourself, e.g. in the Stripe dashboard.
                            </p>
                        }

                        @* the guest can still finish an open Stripe checkout after a cancellation, possibly for the old amount *@
                        @if (_booking.Payments.Any(x => x.PaidAt > CancelledRooms.Min(room => room.Cancellation!.CancelledAt)))
                        {
                            <p class="booking-detail-refund-note booking-detail-paid-after-cancel" role="alert">
                                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                                A payment came in after a cancellation, check the amount and refund any difference to the guest yourself, e.g. in the Stripe dashboard.
                            </p>
                        }
                    </section>
                }

                @* ---------- stay, dates nights and rooms ---------- *@
                <section class="box booking-detail-card booking-detail-stay">
                    <span class="eyebrow">The stay</span>

                    <div class="booking-detail-dates">
                        <div class="booking-detail-date">
                            <span class="booking-detail-label">Check-in</span>
                            <span class="booking-detail-date-day booking-detail-checkin">@Format.Date(_booking.CheckIn)</span>
                            <span class="booking-detail-muted">@_booking.CheckIn.DayOfWeek</span>
                        </div>
                        <div class="booking-detail-nights">
                            <i class="fas fa-moon" aria-hidden="true"></i>
                            <span class="booking-detail-nights-count">@_booking.Nights @(_booking.Nights == 1 ? "night" : "nights")</span>
                        </div>
                        <div class="booking-detail-date">
                            <span class="booking-detail-label">Check-out</span>
                            <span class="booking-detail-date-day booking-detail-checkout">@Format.Date(_booking.CheckOut)</span>
                            <span class="booking-detail-muted">@_booking.CheckOut.DayOfWeek</span>
                        </div>
                    </div>

                    <p class="booking-detail-guests">
                        <i class="fas fa-user-group" aria-hidden="true"></i>
                        <span class="booking-detail-guests-count">@_booking.Adults @(_booking.Adults == 1 ? "guest" : "guests")</span>
                    </p>

                    <h2 class="booking-detail-subtitle">Assigned room@(_booking.Rooms.Count == 1 ? "" : "s")</h2>
                    @if (_booking.Rooms.Count > 0)
                    {
                        <ul class="booking-detail-rooms">
                            @foreach (var room in _booking.Rooms)
                            {
                                <li @key="room.RoomId" class="booking-detail-room @(room.Cancellation is null ? "" : "is-cancelled")">
                                    <span class="booking-detail-room-number">@room.RoomNumber</span>
                                    <div>
                                        <p class="booking-detail-room-name">@room.RoomName</p>
                                        <p class="booking-detail-muted">@room.RateName</p>
                                    </div>
                                    @if (room.Cancellation is not null)
                                    {
                                        <span class="tag is-danger is-light booking-detail-room-tag">Cancelled</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="booking-detail-muted booking-detail-no-rooms">No rooms are assigned to this booking.</p>
                    }
                </section>

                @* ---------- booked rate and cancellation policy, the copy made at booking time ---------- *@
                @if (_booking.Rooms.Count > 0)
                {
                    <section class="box booking-detail-card booking-detail-conditions">
                        <span class="eyebrow">Booking conditions</span>
                        <p class="booking-detail-muted booking-detail-conditions-note">
                            Terms as agreed on @Format.Date(_booking.CreatedAt), later changes to the rates don't apply to this booking.
                        </p>

                        <ul>
                            @foreach (var room in _booking.Rooms)
                            {
                                <li @key="room.RoomId" class="booking-detail-condition">
                                    <div class="booking-detail-condition-header">
                                        <div>
                                            <p class="booking-detail-room-name">Room @room.RoomNumber · <span class="booking-detail-rate-name">@room.RateName</span></p>
                                            <p class="booking-detail-muted booking-detail-policy-text">@CancellationPolicyText.Of(room)</p>
                                        </div>
                                        @if (room.IsRefundable)
                                        {
                                            <span class="tag is-primary is-light booking-detail-policy-tag">Refundable</span>
                                        }
                                        else
                                        {
                                            <span class="tag is-danger is-light booking-detail-policy-tag">Non-refundable</span>
                                        }
                                    </div>

                                    @if (room.IsRefundable)
                                    {
                                        var step = RefundStep(room);
                                        <ol class="booking-detail-timeline">
                                            <li class="@StepClass(step, 0)">
                                                <span class="booking-detail-timeline-percent">100%</span>
                                                <span class="booking-detail-muted">until @Format.Date(room.FullRefundUntil!.Value)</span>
                                            </li>
                                            <li class="@StepClass(step, 1)">
                                                <span class="booking-detail-timeline-percent">@room.PartialRefundPercent%</span>
                                                <span class="booking-detail-muted">until @Format.Date(room.PartialRefundUntil!.Value)</span>
                                            </li>
                                            <li class="@StepClass(step, 2)">
                                                <span class="booking-detail-timeline-percent">0%</span>
                                                <span class="booking-detail-muted">afterwards</span>
                                            </li>
                                        </ol>
                                    }

                                    <p class="booking-detail-entitlement">
                                        <span>@(room.Cancellation is null ? "Refund if cancelled today" : $"Entitlement on {Format.Date(room.RefundReferenceDate)}")</span>
                                        <span class="booking-detail-entitlement-amount">@room.RefundPercent% · @Format.Amount(room.RefundAmount)</span>
                                    </p>
                                </li>
                            }
                        </ul>
                    </section>
                }

                @* ---------- payments ---------- *@
                <section class="box booking-detail-card booking-detail-payments">
                    <span class="eyebrow">Payments</span>

                    @if (_booking.Payments.Count > 0)
                    {
                        <ul>
                            @foreach (var payment in _booking.Payments)
                            {
                                <li @key="payment.Id" class="booking-detail-payment">
                                    <div>
                                        <p>@(payment.PaidAt is null ? "Awaiting payment" : $"Paid {Format.Date(payment.PaidAt.Value)}")</p>
                                        <p class="booking-detail-muted booking-detail-payment-info">
                                            @if (payment.InvoiceNumber is not null)
                                            {
                                                <span>@payment.InvoiceNumber</span>
                                            }
                                            @if (payment.CardLast4 is not null)
                                            {
                                                <span>@Format.Card(payment.CardBrand, payment.CardLast4)</span>
                                            }
                                            @if (payment.StripeReceiptUrl is not null)
                                            {
                                                <a href="@payment.StripeReceiptUrl" target="_blank" rel="noopener">Stripe receipt ↗</a>
                                            }
                                        </p>
                                    </div>
                                    <div class="booking-detail-payment-amount">
                                        <span>@Format.Amount(payment.Amount)</span>
                                        @if (payment.PaidAt is null)
                                        {
                                            <span class="tag is-warning is-light">Open</span>
                                        }
                                        else
                                        {
                                            <span class="tag is-primary is-light">Paid</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="booking-detail-muted booking-detail-no-payments">No payments recorded yet.</p>
                    }
                </section>
            </div>

            @* ---------- guest and price, on the right on big screens, under the stay on phones ---------- *@
            <aside class="booking-detail-aside">
                <section class="box booking-detail-card booking-detail-guest">
                    <span class="eyebrow">The guest</span>
                    <h2 class="booking-detail-guest-name">@_booking.Guest.Name</h2>

                    <dl class="booking-detail-facts">
                        <div>
                            <dt><i class="fas fa-envelope" aria-hidden="true"></i>Email</dt>
                            <dd class="booking-detail-email"><a href="mailto:@_booking.Guest.Email">@_booking.Guest.Email</a></dd>
                        </div>
                        <div>
                            <dt><i class="fas fa-phone" aria-hidden="true"></i>Phone</dt>
                            <dd class="booking-detail-phone"><a href="tel:@_booking.Guest.Phone">@_booking.Guest.Phone</a></dd>
                        </div>
                        <div>
                            <dt><i class="fas fa-location-dot" aria-hidden="true"></i>Address</dt>
                            <dd class="booking-detail-address">
                                @_booking.Guest.AddressLine1
                                @if (_booking.Guest.AddressLine2 is not null)
                                {
                                    <br />@_booking.Guest.AddressLine2
                                }
                                <br />@_booking.Guest.Country
                            </dd>
                        </div>
                    </dl>
                </section>

                <section class="box booking-detail-card booking-detail-price">
                    <span class="eyebrow">Price</span>

                    @foreach (var room in _booking.Rooms)
                    {
                        <div @key="room.RoomId" class="booking-detail-price-row @(room.Cancellation is null ? "" : "is-cancelled")">
                            <span>
                                Room @room.RoomNumber
                                <span class="booking-detail-muted">@Format.Amount(room.PricePerNight) × @_booking.Nights</span>
                            </span>
                            <span>@Format.Amount(room.Total)</span>
                        </div>
                    }

                    @if (CancelledRooms.Count > 0)
                    {
                        <div class="booking-detail-price-row is-summary">
                            <span>Original total</span>
                            <span class="booking-detail-original-total">@Format.Amount(_booking.TotalAmount)</span>
                        </div>
                        @if (_booking.RefundedAmount > 0)
                        {
                            <div class="booking-detail-price-row">
                                <span>Refunds recorded</span>
                                <span class="booking-detail-price-refunds">@Format.Amount(_booking.RefundedAmount)</span>
                            </div>
                        }
                    }

                    <div class="booking-detail-total">
                        <span>@(CancelledRooms.Count > 0 ? "Remaining total" : "Total")</span>
                        <span class="booking-detail-total-amount">@Format.Amount(_booking.ActiveAmount)</span>
                    </div>
                </section>

                @if (ActiveRooms.Count > 0)
                {
                    <Button Variant="ButtonVariant.Danger" IsFullWidth="true" OnClick="OpenCancelDialog" Class="booking-detail-cancel-open">
                        @(ActiveRooms.Count == 1 ? "Cancel booking" : "Cancel rooms")
                    </Button>
                }
            </aside>
        </div>

        @* ---------- cancel dialog, a bottom sheet on phones ---------- *@
        @if (_cancelForm is not null)
        {
            <div class="modal is-active booking-cancel-dialog" role="dialog" aria-modal="true" aria-labelledby="booking-cancel-title">
                <div class="modal-background" @onclick="CloseCancelDialog"></div>
                <div class="modal-content booking-cancel-sheet">
                    <EditForm Model="_cancelForm" OnValidSubmit="CancelAsync">
                        <FluentValidationValidator />

                        <span class="eyebrow">Booking @_booking.BookingNumber</span>
                        <h2 id="booking-cancel-title" class="booking-cancel-title">@(ActiveRooms.Count == 1 ? "Cancel this booking?" : "Which rooms do you want to cancel?")</h2>
                        <p class="booking-detail-muted">
                            Cancelled rooms become available again. The booking, its prices and payments stay visible here.
                        </p>

                        @if (ActiveRooms.Count > 1)
                        {
                            <label class="booking-cancel-select-all">
                                <input type="checkbox" checked="@AllActiveRoomsSelected" @onchange="ToggleAllRooms" />
                                <span>Select all rooms</span>
                            </label>
                        }

                        <ul class="booking-cancel-rooms">
                            @foreach (var room in ActiveRooms)
                            {
                                var selection = SelectionOf(room);
                                <li @key="room.BookingRoomId" class="booking-cancel-room @(selection is null ? "" : "is-selected")">
                                    <label class="booking-cancel-room-toggle">
                                        <input type="checkbox" checked="@(selection is not null)" @onchange="() => ToggleRoom(room)" />
                                        <span class="booking-cancel-room-info">
                                            <span class="booking-detail-room-name">Room @room.RoomNumber · @room.RoomName</span>
                                            @* a tag and not plain text, rates are often named after their policy *@
                                            <span class="booking-detail-muted is-block">
                                                @room.RateName
                                                <span class="tag @(room.IsRefundable ? "is-primary" : "is-danger") is-light">@(room.IsRefundable ? "Refundable" : "Non-refundable")</span>
                                            </span>
                                            <span class="booking-cancel-room-due is-block">Policy: @room.RefundPercent% · @Format.Amount(room.RefundAmount)</span>
                                        </span>
                                    </label>
                                    @if (selection is not null)
                                    {
                                        <div class="booking-cancel-room-refund">
                                            <label class="label" for="booking-cancel-refund-@room.BookingRoomId">Refund (€)</label>
                                            <div class="control">
                                                <InputNumber @bind-Value="selection.RefundAmount" id="@($"booking-cancel-refund-{room.BookingRoomId}")" class="input" min="0" max="@room.Total" step="0.01"
                                                             inputmode="decimal" disabled="@(_booking.RefundableAmount == 0)" />
                                            </div>
                                            <ValidationMessage For="() => selection.RefundAmount" class="help is-danger" />
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                        <ValidationMessage For="() => _cancelForm.Rooms" class="help is-danger" />

                        <div class="booking-cancel-summary">
                            <span class="booking-cancel-summary-count">@_cancelForm.Rooms.Count of @ActiveRooms.Count @(ActiveRooms.Count == 1 ? "room" : "rooms") selected</span>
                            <span class="booking-cancel-summary-total">Total refund @Format.Amount(SelectedRefundTotal) of @Format.Amount(_booking.RefundableAmount) refundable</span>
                        </div>

                        @if (_booking.PaidAmount == 0)
                        {
                            <p class="help booking-cancel-refund-hint">Nothing has been paid, so there is nothing to refund.</p>
                        }

                        @if (IsRefundAboveLimit)
                        {
                            <p class="help is-danger booking-cancel-refund-limit" role="alert">The refunds can't be more than @Format.Amount(_booking.RefundableAmount).</p>
                        }

                        @if (_cancelForm.Rooms.Count > 0 && AllActiveRoomsSelected)
                        {
                            <p class="booking-detail-refund-note booking-cancel-whole-note">
                                <i class="fas fa-circle-info" aria-hidden="true"></i>
                                No rooms remain, so this cancels the whole booking.
                            </p>
                        }

                        @if (NeedsNewGuestCount)
                        {
                            <div class="field mt-4 booking-cancel-guests">
                                <label class="label is-required" for="booking-cancel-adults">New number of guests</label>
                                <div class="control">
                                    <InputNumber @bind-Value="_cancelForm.Adults" id="booking-cancel-adults" class="input" min="1" max="@RemainingCapacity" step="1" inputmode="numeric" />
                                </div>
                                <ValidationMessage For="() => _cancelForm.Adults" class="help is-danger" />
                                <p class="help booking-cancel-guests-hint">
                                    The booking has @_booking.Adults guests, but the remaining rooms fit at most @RemainingCapacity.
                                </p>
                            </div>
                        }

                        <div class="field mt-4">
                            <label class="label is-required" for="booking-cancel-reason">Reason</label>
                            <div class="control">
                                <InputTextArea @bind-Value="_cancelForm.Reason" id="booking-cancel-reason" class="textarea" rows="3" maxlength="500"
                                               placeholder="e.g. Guest asked to cancel by phone" />
                            </div>
                            <ValidationMessage For="() => _cancelForm.Reason" class="help is-danger" />
                        </div>

                        <p class="booking-detail-refund-note">
                            <i class="fas fa-circle-info" aria-hidden="true"></i>
                            The refund is only recorded, the website does not pay it back. Handle it yourself, e.g. in the Stripe dashboard.
                        </p>

                        @if (_cancelError is not null)
                        {
                            <p class="help is-danger booking-cancel-error" role="alert">@_cancelError</p>
                        }

                        <div class="booking-cancel-actions">
                            <Button Variant="ButtonVariant.Secondary" OnClick="CloseCancelDialog" IsDisabled="_isCancelling">Keep booking</Button>
                            <Button Type="submit" Variant="ButtonVariant.Danger" IsLoading="_isCancelling" IsDisabled="IsRefundAboveLimit" Class="booking-cancel-confirm">
                                @(_cancelForm.Rooms.Count > 0 && AllActiveRoomsSelected ? "Cancel booking" : _cancelForm.Rooms.Count == 1 ? "Cancel 1 room" : $"Cancel {_cancelForm.Rooms.Count} rooms")
                            </Button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    }
</div>
