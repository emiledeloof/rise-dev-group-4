@page "/admin/extra-services"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Shared.Identity
@using Rise.Shared.ExtraServices

<PageTitle>Extra Services</PageTitle>
<div class="page">
    <div class="service-heading service-page-heading">
        <div>
            <h1 class="title service-title">Extra Services</h1>
            <p class="service-subtitle">Manage additional services offered across the estate</p>
        </div>
        <div class="service-page-actions">
            <Button OnClick="OpenCreateForm">New extra service</Button>
        </div>
    </div>

    @if (_services is null)
    {
        <p class="service-loading"><em>Loading...</em></p>
    }
    else
    {
        @if (_message is not null)
        {
            <p class="notification @(_messageIsError ? "is-danger" : "is-success") is-light service-alert">@_message</p>
        }

        <div class="box service-list">
            @if (_services.Count == 0 && !_loadFailed)
            {
                <p class="service-muted">No extra services yet. Click "New extra service" to add one.</p>
            }
            else
            {
                <div class="service-table-scroll">
                    <table class="service-table">
                        <thead>
                        <tr>
                            <th scope="col">Service Name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Price & Pricing Model</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="has-text-right"><span class="is-sr-only">Actions</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var service in _services)
                        {
                            <tr @key="service.Id" class="@(service.IsActive ? "" : "service-row-inactive")">
                                <td class="service-name-cell">
                                    <span class="service-name-text">@service.Name</span>
                                </td>
                                <td class="service-description-cell">
                                    <span class="service-description-text">@(service.Description ?? "—")</span>
                                </td>
                                <td class="service-pricing-cell">
                                    <span class="service-price-amount">@FormatPrice(service.Price)</span>
                                    <span class="service-price-meta">@FormatPricingModel(service.Cadence, service.IsPerPerson)</span>
                                </td>
                                <td class="service-status-cell">
                                    @if (service.IsActive)
                                    {
                                        <span class="service-badge service-badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="service-badge service-badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="service-actions-cell">
                                    <div class="service-actions">
                                        <Button Variant="ButtonVariant.Secondary"
                                                Class="service-btn-action"
                                                OnClick="() => OpenEditForm(service)">
                                            Edit
                                        </Button>
                                        <Button Variant="@(service.IsActive ? ButtonVariant.Secondary : ButtonVariant.Primary)"
                                                Class="@(service.IsActive ? "service-btn-action service-deactivate-btn" : "service-btn-action service-activate-btn")"
                                                OnClick="() => ToggleActiveAsync(service)">
                                            @(service.IsActive ? "Deactivate" : "Activate")
                                        </Button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (_formModel is not null)
        {
            <section class="service-panel" aria-labelledby="service-form-heading">
                <div class="service-panel-header">
                    <h2 id="service-form-heading">@(_formModel is ExtraServiceRequest.Edit ? "Edit extra service" : "New extra service")</h2>
                    <p class="service-panel-sub">Configure service details, pricing cadence, and whether it applies per person or booking.</p>
                </div>

                <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                    <FluentValidationValidator />

                    <div class="service-form-grid">
                        <label class="service-field service-field-full">
                            <span class="service-label">Service Name</span>
                            <InputText @bind-Value="_formModel.Name" id="service-name" placeholder="e.g. Breakfast, Extra Cleaning, Bicycle Rental" />
                            <ValidationMessage For="() => _formModel.Name" class="help is-danger" />
                        </label>

                        <label class="service-field service-field-full">
                            <span class="service-label">Description (Optional)</span>
                            <InputTextArea @bind-Value="_formModel.Description" id="service-description" rows="2" placeholder="Details about what the service includes..." />
                            <ValidationMessage For="() => _formModel.Description" class="help is-danger" />
                        </label>

                        <label class="service-field">
                            <span class="service-label">Price (EUR)</span>
                            <InputNumber @bind-Value="_formModel.Price" id="service-price" step="0.50" min="0" />
                            <ValidationMessage For="() => _formModel.Price" class="help is-danger" />
                        </label>

                        <label class="service-field">
                            <span class="service-label">Billing Cadence</span>
                            <div class="service-select-wrap">
                                <InputSelect @bind-Value="_formModel.Cadence" id="service-cadence">
                                    <option value="@ChargeCadence.PerNight">Per Night</option>
                                    <option value="@ChargeCadence.Once">Once (Per Stay / Booking)</option>
                                </InputSelect>
                                <span class="service-select-arrow" aria-hidden="true"></span>
                            </div>
                        </label>

                        <label class="service-field">
                            <span class="service-label">Charging Scope</span>
                            <div class="service-select-wrap">
                                <InputSelect @bind-Value="_formModel.IsPerPerson" id="service-target">
                                    <option value="true">Per Person (multiplied by guests)</option>
                                    <option value="false">Per Booking (fixed amount)</option>
                                </InputSelect>
                                <span class="service-select-arrow" aria-hidden="true"></span>
                            </div>
                        </label>
                    </div>

                    <div class="service-summary-card">
                        <div class="service-summary-icon">
                            <i class="fas fa-calculator" aria-hidden="true"></i>
                        </div>
                        <div class="service-summary-content">
                            <span class="service-summary-label">Price Preview</span>
                            <span class="service-summary-text">
                                <strong>@FormatPrice(_formModel.Price)</strong> @FormatPricingModel(_formModel.Cadence, _formModel.IsPerPerson)
                            </span>
                        </div>
                    </div>

                    @if (_formModel is ExtraServiceRequest.Edit editModel)
                    {
                        <div class="service-status-toggle">
                            <label class="service-checkbox-label">
                                <InputCheckbox @bind-Value="editModel.IsActive" id="service-active" />
                                <span>Active and offered for rates &amp; bookings</span>
                            </label>
                        </div>
                    }

                    @if (_formError is not null)
                    {
                        <p class="notification is-danger is-light service-form-error">@_formError</p>
                    }

                    <div class="service-form-actions">
                        <Button Type="submit" Variant="ButtonVariant.Primary" IsDisabled="_isSaving">
                            @(_isSaving ? "Saving..." : "Save Service")
                        </Button>
                        <Button Variant="ButtonVariant.Secondary" OnClick="CloseForm">Cancel</Button>
                    </div>
                </EditForm>
            </section>
        }
    }
</div>
