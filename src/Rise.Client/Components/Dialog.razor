@* shared dialog, a bottom sheet on phones and a centered card from tablets on, styles in Dialog.razor.css *@
@* the page keeps the open state and decides what closing means, eg asking about unsaved changes first *@
@if (IsOpen)
{
    <div class="dialog-layer @(IsAlert ? "is-alert" : "") @Class">
        <div class="dialog-backdrop" @onclick="OnBackdropClickAsync"></div>
        <section @ref="_panel"
                 class="dialog dialog-@Size.ToString().ToLowerInvariant()"
                 role="@(IsAlert ? "alertdialog" : "dialog")"
                 aria-modal="true"
                 aria-labelledby="@_titleId"
                 aria-describedby="@(Description is null ? null : _descriptionId)"
                 tabindex="-1"
                 @onkeydown="OnKeyDownAsync">
            <header class="dialog-header">
                <div class="dialog-heading">
                    <h2 id="@_titleId" class="dialog-title">@Title</h2>
                    @if (Description is not null)
                    {
                        <p id="@_descriptionId" class="dialog-description">@Description</p>
                    }
                </div>
                @if (ShowCloseButton)
                {
                    <button type="button" class="dialog-close" aria-label="Close" @onclick="CloseAsync">
                        <i class="fas fa-xmark" aria-hidden="true"></i>
                    </button>
                }
            </header>

            @if (ChildContent is not null)
            {
                <div class="dialog-body">
                    @ChildContent
                </div>
            }

            @if (Footer is not null)
            {
                <footer class="dialog-footer">
                    @Footer
                </footer>
            }
        </section>
    </div>
}
