@inherits LayoutComponentBase
@inject NavigationManager Navigation
<div class="admin-shell">
    <aside class="admin-sidebar">
        @* real logo like the navbar of the site, emblem next to the name, see wwwroot/images/logo *@
        <a class="admin-brand" href="/admin">
            <img class="admin-brand-emblem" src="images/logo/emblem.png" alt="" />
            <img class="admin-brand-name" src="images/logo/la-vigna-di-maria.png" alt="Stazzu La Vigna di Maria" />
        </a>
        <nav aria-label="Admin navigation">
            <NavLink href="/admin" Match="NavLinkMatch.All">Booking matrix</NavLink>
            @* also active on a booking detail, eg /admin/bookings/3, the layout re-renders on every navigation *@
            <NavLink href="/admin/booking-list" class="@(IsBookingDetail ? "active" : null)">Bookings</NavLink>
            <NavLink href="/admin/invoice-list">Invoices</NavLink>
            <NavLink href="/admin/room-types">Room types</NavLink>
            <NavLink href="/admin/amenities">Amenities</NavLink>
            <NavLink href="/admin/rooms">Rooms</NavLink>
            <NavLink href="/admin/rates">Rates</NavLink>
        </nav>

        @* back to the guest side of the site, at the bottom of the sidebar *@
        <a class="admin-back" href="/">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Back to the site
        </a>
    </aside>
    <main class="admin-content">
        @Body
    </main>
</div>

@code {
    private bool IsBookingDetail =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/bookings/", StringComparison.OrdinalIgnoreCase);
}
