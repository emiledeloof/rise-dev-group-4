@inherits LocalizedComponentBase
@* "your selection" box of the results page, styles in SelectionSummary.razor.css *@
<aside class="selection-summary" aria-label="@Text["YourSelection"]">
    <h2 class="selection-summary-title">@Text["YourSelection"]</h2>
    <p class="selection-summary-meta">@Nights @(Nights == 1 ? Text["Night"] : Text["Nights"])</p>

    @if (Rooms.Count == 0)
    {
        @* nothing picked yet, short hint instead of an empty box *@
        <p class="selection-summary-empty">@Text["ChooseRatePrompt"]</p>
    }
    else
    {
        @* one line per picked room, room and rate on the left, price on the right *@
        <ul class="selection-summary-list">
            @foreach (var room in Rooms)
            {
                <li class="selection-summary-room">
                    <span class="selection-summary-room-name">@room.RoomName</span>
                    <span class="selection-summary-rate-name">@room.RateName</span>
                    <span class="selection-summary-price">@Format.Amount(room.TotalPrice)</span>
                </li>
            }
        </ul>

        @* total of all the rooms *@
        <p class="selection-summary-total">
            <span>@Text["Total"]</span>
            <span>@Format.Amount(Total)</span>
        </p>
    }

    <p class="selection-summary-vat">@Text["PricesIncludeVat"]</p>

    @* next step of the booking, the page stores the selection and goes to the guest details *@
    <Button IsFullWidth="true" IsDisabled="Rooms.Count == 0" OnClick="() => OnContinue.InvokeAsync()">@Text["Continue"]</Button>
</aside>

@code {
    protected override async Task OnInitializedAsync()
    {
        await LoadTextAsync();
    }
}
