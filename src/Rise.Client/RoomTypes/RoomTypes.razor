@page "/admin/room-types"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using Rise.Shared.Amenities
@using Rise.Shared.Common
@using Rise.Shared.Identity
@using Rise.Shared.RoomTypes

<PageTitle>Room types</PageTitle>
<UnsavedChangesGuard @ref="_guard" IsDirty="IsDirty" />
<div class="page">
    <div class="room-type-heading">
        <h1 class="title">Room types</h1>
        <Button OnClick="OpenCreateFormAsync">New room type</Button>
    </div>

    @if (_roomTypes is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (_message is not null)
        {
            <p class="notification @(_messageIsError ? "is-danger" : "is-success") is-light">@_message</p>
        }

        <div class="box room-type-list">
            @* ! no empty state after a failed load, the list is not really empty *@
            @if (_roomTypes.Count == 0 && !_loadFailed)
            {
                <p class="room-type-muted">No room types yet.</p>
            }
            else
            {
                <div class="room-type-table-scroll">
                    <table class="room-type-table">
                        <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Rooms</th>
                            <th scope="col"><span class="is-sr-only">Actions</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var roomType in _roomTypes)
                        {
                            <tr @key="roomType.Id">
                                <td class="room-type-name">@roomType.Name</td>
                                <td class="room-type-description">@(roomType.Description ?? "—")</td>
                                <td class="room-type-rooms">@(roomType.RoomNumbers.Count == 0 ? "—" : string.Join(", ", roomType.RoomNumbers))</td>
                                <td class="room-type-actions">
                                    @* ! second click needed to delete, no browser dialog *@
                                    @if (_pendingDeleteId == roomType.Id)
                                    {
                                        <Button Variant="ButtonVariant.Danger" OnClick="() => DeleteAsync(roomType)">Confirm delete</Button>
                                        <Button Variant="ButtonVariant.Secondary" OnClick="CancelDelete">Cancel</Button>
                                    }
                                    else
                                    {
                                        <Button Variant="ButtonVariant.Secondary" OnClick="() => OpenEditFormAsync(roomType)" Class="room-type-edit">Edit</Button>
                                        <Button Variant="ButtonVariant.Danger" OnClick="() => AskDeleteAsync(roomType)">Delete</Button>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* one form for create and edit, the type of the model decides which api is called *@
        @if (_formModel is not null)
        {
            <section class="room-type-panel" aria-labelledby="room-type-form-heading">
                <h3 id="room-type-form-heading">@(_formModel is RoomTypeRequest.Edit ? "Edit room type" : "New room type")</h3>

                <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                    <FluentValidationValidator />
                    <label class="room-type-field">
                        <span>Name</span>
                        <InputText @bind-Value="_formModel.Name" id="room-type-name" />
                        <ValidationMessage For="() => _formModel.Name" class="help is-danger" />
                    </label>

                    <label class="room-type-field">
                        <span>Description</span>
                        <InputTextArea @bind-Value="_formModel.Description" id="room-type-description" rows="3" />
                        <ValidationMessage For="() => _formModel.Description" class="help is-danger" />
                    </label>

                    @* ---------- what the guest sees on the room page ---------- *@
                    <fieldset class="room-type-characteristics">
                        <legend>Characteristics</legend>
                        <p class="room-type-help">The ticked amenities are shown to guests on the room page, in their language.</p>

                        @if (ActiveAmenities.Count == 0)
                        {
                            <p class="room-type-muted room-type-no-amenities">No active amenities yet. <a href="/admin/amenities">Add amenities</a></p>
                        }
                        else
                        {
                            <div class="room-type-amenities">
                                @foreach (var amenity in ActiveAmenities)
                                {
                                    var id = amenity.Id;
                                    <label class="room-type-amenity" @key="id">
                                        <input type="checkbox" value="@id" checked="@_formModel.AmenityIds.Contains(id)"
                                               @onchange="e => ToggleAmenity(id, e.Value is true)" />
                                        <i class="fas @amenity.Icon" aria-hidden="true"></i>
                                        <span>@NameOf(amenity)</span>
                                    </label>
                                }
                            </div>
                        }

                        @if (InactiveAssignedNames.Count > 0)
                        {
                            <p class="room-type-help room-type-inactive">
                                Also assigned but inactive, so hidden from guests: @string.Join(", ", InactiveAssignedNames).
                            </p>
                        }

                        <label class="room-type-field room-type-bed">
                            <span>Bed configuration (English)</span>
                            @* ! plain input, InputText cannot bind to a dictionary entry *@
                            <input id="room-type-bed-en" maxlength="100" placeholder="e.g. California king bed"
                                   value="@_formModel.BedConfigurations.GetValueOrDefault(Languages.Default)"
                                   @oninput="e => _formModel.BedConfigurations[Languages.Default] = e.Value?.ToString()" />
                        </label>

                        <details class="room-type-translations">
                            <summary>Bed configuration in other languages</summary>
                            <div class="room-type-translation-grid">
                                @foreach (var language in Languages.Supported.Skip(1))
                                {
                                    var lang = language;
                                    <label class="room-type-field">
                                        <span>@Languages.Names[lang]</span>
                                        <input id="room-type-bed-@lang" lang="@lang" maxlength="100"
                                               value="@_formModel.BedConfigurations.GetValueOrDefault(lang)"
                                               @oninput="e => _formModel.BedConfigurations[lang] = e.Value?.ToString()" />
                                    </label>
                                }
                            </div>
                            <p class="room-type-help">An empty language shows the English text to the guest.</p>
                        </details>
                        <ValidationMessage For="() => _formModel.BedConfigurations" class="help is-danger" />
                        <ValidationMessage For="() => _formModel.AmenityIds" class="help is-danger" />
                    </fieldset>

                    @if (_formError is not null)
                    {
                        <p class="notification is-danger is-light">@_formError</p>
                    }

                    <div class="room-type-form-actions">
                        <Button Type="submit" IsLoading="_isSaving" Class="room-type-save">Save</Button>
                        <Button Variant="ButtonVariant.Secondary" OnClick="CancelFormAsync" Class="room-type-cancel">Cancel</Button>
                    </div>
                </EditForm>
            </section>
        }
    }
</div>
