@* guest & room selector popup for the search bar, styles in GuestPicker.razor.css *@
<div class="gp">
    @* field showing current guest and room count, opens or closes the counter panel *@
    <button type="button"
            class="gp-field"
            aria-expanded="@(IsOpenValue ? "true" : "false")"
            aria-label="@(HasRooms ? "Guests and rooms selector" : "Guests selector")"
            @onclick="Toggle">
        <span class="gp-label">@LabelText</span>
        <span class="gp-value">@FieldText</span>
    </button>

    @if (IsOpenValue)
    {
        <div class="gp-panel" role="dialog" aria-label="Choose number of guests and rooms">
            <div class="gp-row">
                <div class="gp-info">
                    <span class="gp-title">Adults</span>
                    <span class="gp-subtitle">Ages 18 or above</span>
                </div>

                <div class="gp-counter">
                    <button type="button"
                            class="gp-counter-btn"
                            disabled="@(!CanDecreaseAdults)"
                            aria-label="Decrease adults"
                            @onclick="DecreaseAdults">
                        −
                    </button>

                    <span class="gp-count" aria-live="polite">@Value</span>

                    <button type="button"
                            class="gp-counter-btn"
                            disabled="@(!CanIncreaseAdults)"
                            aria-label="Increase adults"
                            @onclick="IncreaseAdults">
                        +
                    </button>
                </div>
            </div>

            @if (HasRooms)
            {
                <div class="gp-row">
                    <div class="gp-info">
                        <span class="gp-title">Rooms</span>
                        <span class="gp-subtitle">Up to @MaxRooms rooms</span>
                    </div>

                    <div class="gp-counter">
                        <button type="button"
                                class="gp-counter-btn"
                                disabled="@(!CanDecreaseRooms)"
                                aria-label="Decrease rooms"
                                @onclick="DecreaseRooms">
                            −
                        </button>

                        <span class="gp-count gp-count-rooms" aria-live="polite">@Rooms</span>

                        <button type="button"
                                class="gp-counter-btn"
                                disabled="@(!CanIncreaseRooms)"
                                aria-label="Increase rooms"
                                @onclick="IncreaseRooms">
                            +
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_notice))
                {
                    <div class="gp-notice" role="status">
                        @_notice
                    </div>
                }
            }

            <div class="gp-footer">
                @if (Max > 0)
                {
                    <span class="gp-capacity-hint">Max @Max guests</span>
                }
                <button type="button" class="gp-done-btn" aria-label="Close guest picker" @onclick="Close">Done</button>
            </div>
        </div>
    }
</div>
