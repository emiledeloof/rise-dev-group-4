@* one room in the search results, styles in RoomCard.razor.css *@
<article class="room-card">
    @* photo of the room, a beige block is shown when there is no photo yet *@
    @if (!string.IsNullOrWhiteSpace(PhotoUrl))
    {
        <img src="@PhotoUrl" alt="Photo of the @Name" class="room-card-photo" loading="lazy" />
    }
    else
    {
           <div class="room-card-photo is-placeholder" aria-hidden="true"></div>
    }

    <div class="room-card-body">
        @* room name in the title font *@
        @* the name links to the room detail page when the page gives a url *@
        <h3>
            @if (!string.IsNullOrWhiteSpace(DetailsUrl))
            {
                <a href="@DetailsUrl" class="room-card-title-link">@Name</a>
            }
            else
            {
                @Name
            }
        </h3>

        @* short description, only shown when there is one *@
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="room-card-description">@Description</p>
        }

        @* capacity, eg up to 2 guests *@
        <p class="room-card-meta">Up to @MaxGuests @(MaxGuests == 1 ? "guest" : "guests")</p>

        @* link to the room detail page, only when the page gives a url *@
        @if (!string.IsNullOrWhiteSpace(DetailsUrl))
        {
            <a href="@DetailsUrl" class="room-card-details-link">View details</a>
        }

        @* rates of the room for the stay, cheapest first, styles in RoomCard.razor.css *@
        <div class="room-card-prices">
            @* nb of nights once for all the rates, night or nights like on the results page *@
            <p class="room-card-price-detail">@Nights @(Nights == 1 ? "night" : "nights") · prices include VAT</p>

            @* one line per rate, a radio btn to pick it, the price per night next to it and the total on the right *@
            <ul class="room-card-rates">
                @foreach (var rate in Rates)
                {
                    @* a rate that needs more nights than the stay is greyed out and its radio is disabled *@
                    var bookable = MinStayText.IsBookable(rate, Nights);
                    var minStay = MinStayText.Of(rate, Nights);

                    @* the whole line is a label so a click anywhere on it picks the rate *@
                    <li>
                    <label class="room-card-rate @(bookable ? null : "is-unavailable")">

                        @* radio btn of the rate, same name for all the rates of this room so only one can be checked *@
                        @* checked when this rate is the one in the selection, picking it tells the page with OnRateSelected *@
                        <input type="radio" class="room-card-rate-radio"
                            name="rate-@Name"
                            checked="@(rate.Id == SelectedRateId)"
                            disabled="@(!bookable)"
                            @onchange="() => PickRateAsync(rate)" />

                        @* rate name so the guest can tell the rates of the room apart, eg Non-refundable or Refundable *@
                        @* the conditions are the policy line below, the description would say the same thing *@
                        <span class="room-card-rate-name">@rate.Name</span>
                        @* detail eg €109 × 3 nights in room-card-rate-detail, total on the right in room-card-total *@
                        <span class="room-card-total">€@rate.TotalPrice.ToString("0")</span>
                        <span class="room-card-rate-detail">€@rate.PricePerNight.ToString("0") × @Nights @(Nights == 1 ? "night" : "nights")</span>
                        @* cancellation policy of the rate under the price, on a 2nd row of the grid *@
                        <span class="room-card-rate-policy">@CancellationPolicyText.Of(rate)</span>
                        @* min nb of nights of the rate, no line when the rate has no minimum *@
                        @if (minStay is not null)
                        {
                            <span class="room-card-rate-min-stay">@minStay</span>
                        }
                    </label>
                    </li>
                }
            </ul>
        </div>

        @* not in the selection yet, select adds the room with its cheapest bookable rate *@
        @* already in the selection, remove takes it out *@
        @if ((SelectedRateId == null) && BookableRates.Any())
        {
            <Button OnClick="SelectCheapestAsync" Class="select-btn">Select</Button>
        }
        else if ((SelectedRateId != null))
        {
            <Button Variant="ButtonVariant.Secondary" OnClick="OnRemove" Class="select-btn">Remove</Button>
        }
    </div>
</article>
