# Copy to `.env` (git-ignored) and set your own POSTGRES_PASSWORD. docker-compose.yml won't start without it.
# Use the same password in your user secret for the app (`dotnet user-secrets set ...`, see README).
# Postgres only applies the password when the volume is first created: after changing it run `docker compose down -v`.
# If you change DB/user/port, also update your user secret and Username/MaintenanceDB in docker/pgadmin/servers.json.
POSTGRES_DB=rise
POSTGRES_USER=rise
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Docker deployment (docker-compose.local.yml / docker-compose.prod.yml), not needed for development ---
APP_PORT=8080
# Seed test data (local: true by default, prod: false by default)
APP_SEED=true
# Stripe test keys (same values as your user secrets; locally the app starts without them, but payments fail)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/
STRIPE_CANCEL_URL=http://localhost:8080/
