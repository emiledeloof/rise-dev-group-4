@page "/search"
@* stay search page, the guest picks the dates of the stay here *@
@inherits LocalizedComponentBase

<PageTitle>@Text["FindYourStay"]</PageTitle>

@* centered frame, see .page in theme.css *@
<div class="page">
    <span class="eyebrow">@Text["BookARoom"]</span>
    <h1>@Text["FindYourStay"]</h1>
    <p class="subtitle">@Text["FindYourStaySubtitle"]</p>

    @* same search bar as the home and results pages, it goes to the results page on submit *@
    <SearchBar />
</div>
