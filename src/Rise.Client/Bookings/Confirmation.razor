@inherits LocalizedComponentBase
@page "/booking/confirmation"
@using Rise.Shared.Bookings

<PageTitle>@Text["BookingConfirmation"]</PageTitle>

@if (booking is null && errorMessage is null)
{
    <p>@Text["LoadingBooking"]</p>
}
else if (errorMessage is not null)
{
    <div class="confirmation-page">
        <p class="notification is-danger">@errorMessage</p>
    </div>
}
else if (booking is not null)
{
<div class="confirmation-page">
    <header class="confirmation-header">
        <span class="confirmation-status">@(IsPaid ? Text["Confirmed"] : Text["PaymentProcessing"])</span>
        <p class="booking-number">@Text["Booking"] @booking.BookingNumber</p>
        @if (IsPaid)
        {
            <h1 class="title">@Text["ThankYouStayConfirmed"]</h1>
            <p class="booking-email">
                @Text["ConfirmationEmailOnItsWay"] @booking.Guest.Email.
            </p>
        }
        else
        {
            <h1 class="title">@Text["ConfirmingPayment"]</h1>
            <p class="booking-email">
                @(isPolling
                    ? Text["PaymentConfirmationDelay"]
                    : $"{Text["ConfirmationEmailAfterPayment"]} {booking.Guest.Email} once the payment is processed.")
            </p>
        }
    </header>

    <section class="box booking-details" aria-labelledby="booking-details-title">
        <h2 id="booking-details-title" class="booking-details-title">
            @Text["BookingDetails"]
        </h2>

        <dl class="booking-details-list">
            <div class="booking-detail-row">
                <dt>@Text["BookingId"]</dt>
                <dd>@booking.BookingNumber</dd>
            </div>
            <div class="booking-detail-row">
                <dt>@Text["Stay"]</dt>
                <dd>
                    @booking.CheckIn.ToString("dd MMM yyyy") –
                    @booking.CheckOut.ToString("dd MMM yyyy") · 
                    @numberOfNights @(numberOfNights == 1 ? Text["Night"] : Text["Nights"])
                </dd>
            </div>
            <div class="booking-detail-row">
                <dt>@Text["Room"]</dt>
                <dd>@roomName · @guestCount @(guestCount == 1 ? Text["Guest"] : Text["Guests"])</dd>
            </div>
            <div class="booking-detail-row">
                <dt>@Text["Rate"]</dt>
                <dd>@FormatAmount(paymentAmount)</dd>
            </div>
            <div class="booking-detail-row">
                <dt>@Text["Payment"]</dt>
                <dd>@(IsPaid ? Text["Paid"] : Text["Pending"])</dd>
            </div>
        </dl>

        <p class="cancellation-note">@Text["CancellationDetails"]</p>
    </section>
    
    <div class="buttons">
        <Button Variant="ButtonVariant.Secondary" Href="">@Text["BackToHome"]</Button>
    </div>
</div>
}
