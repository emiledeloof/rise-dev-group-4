@page "/admin/promotion-codes"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using System.ComponentModel.DataAnnotations
@using Rise.Shared.Identity

<PageTitle>Promotion codes</PageTitle>

<div class="page promotion-codes-page">
    <div class="promotion-codes-heading">
        <h1 class="title">Promotion codes</h1>
        <Button OnClick="ToggleCreateForm" Variant="ButtonVariant.Primary">
            @(IsCreateFormOpen ? "Close" : "New promotion code")
        </Button>
    </div>

    @if (IsCreateFormOpen)
    {
        <EditForm Model="_model" OnValidSubmit="SavePromotionCode">
            <DataAnnotationsValidator />
            <section class="promotion-code-form box" aria-labelledby="promotion-code-form-title">
                <h2 id="promotion-code-form-title">@(_model.Code is null ? "New promotion code" : _model.Code)</h2>

                <div class="promotion-code-fields">
                    <div class="promotion-code-field">
                        <label for="promotion-code">Code</label>
                        <InputText id="promotion-code" class="input" @bind-Value="_model.Code" />
                        <ValidationMessage For="() => _model.Code" />
                    </div>

                    <div class="promotion-code-field">
                        <label for="discount-type">Discount type</label>
                        <InputSelect id="discount-type" class="input" @bind-Value="_model.DiscountType">
                            <option value="Percentage">Percentage</option>
                            <option value="Fixed">Fixed amount</option>
                        </InputSelect>
                    </div>

                    <div class="promotion-code-field">
                        <label for="discount-value">Value</label>
                        <InputNumber id="discount-value" class="input" @bind-Value="_model.Value" />
                        <ValidationMessage For="() => _model.Value" />
                    </div>

                    <div class="promotion-code-field">
                        <label for="valid-from">Valid from–to</label>
                        <div class="promotion-code-date-range">
                            <InputDate id="valid-from" class="input" @bind-Value="_model.ValidFrom" />
                            <span aria-hidden="true">–</span>
                            <InputDate id="valid-to" class="input" @bind-Value="_model.ValidTo" />
                        </div>
                        <ValidationMessage For="() => _model.ValidFrom" />
                        <ValidationMessage For="() => _model.ValidTo" />
                    </div>

                    <div class="promotion-code-field promotion-code-field-full">
                        <label for="email-restriction">Restrict to one e-mail address <span>(optional)</span></label>
                        <InputText id="email-restriction"
                                   class="input"
                                   @bind-Value="_model.EmailRestriction"
                                   placeholder="Leave empty for anyone" />
                    </div>

                    <div class="promotion-code-field promotion-code-field-full">
                        <label for="applies-to">Applies to</label>
                        <InputSelect id="applies-to" class="input" @bind-Value="_model.AppliesTo">
                            <option value="NonRefundable">Non-refundable rate only</option>
                            <option value="AllRates">All rates</option>
                        </InputSelect>
                    </div>
                </div>

                <label class="promotion-code-active">
                    <InputCheckbox @bind-Value="_model.IsActive" />
                    <span>Active</span>
                </label>

                <p class="promotion-code-notice">
                    Discounts and <strong>promotion codes</strong> are calculated on the amount excluding VAT.
                </p>

                <div class="promotion-code-actions">
                    <button class="button is-primary promotion-code-save" type="submit">Save promotion code</button>
                    <button class="button is-light" type="button" @onclick="CloseCreateForm">Cancel</button>
                </div>
                @if (_formMessage is not null)
                {
                    <p class="notification is-info is-light mt-3">@_formMessage</p>
                }
            </section>
        </EditForm>
    }
</div>

@code {
    private bool IsCreateFormOpen { get; set; }
    private PromotionCodeFormModel _model = new();
    private string? _formMessage;

    private void ToggleCreateForm()
    {
        if (IsCreateFormOpen)
        {
            CloseCreateForm();
            return;
        }

        _model = new PromotionCodeFormModel();
        _formMessage = null;
        IsCreateFormOpen = true;
    }

    private void CloseCreateForm()
    {
        IsCreateFormOpen = false;
        _model = new PromotionCodeFormModel();
        _formMessage = null;
    }

    private void SavePromotionCode()
    {
        _formMessage = "The form is valid. Persistence will be connected in the next promotion-code slice.";
    }

    private sealed class PromotionCodeFormModel
    {
        [Required(ErrorMessage = "Code is required.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Code must contain between 2 and 50 characters.")]
        public string? Code { get; set; }

        public string DiscountType { get; set; } = "Percentage";

        [Range(0.01, 100000, ErrorMessage = "Value must be greater than 0.")]
        public decimal Value { get; set; } = 10;

        [Required(ErrorMessage = "A start date is required.")]
        public DateTime? ValidFrom { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "An end date is required.")]
        public DateTime? ValidTo { get; set; } = DateTime.Today.AddMonths(1);

        [EmailAddress(ErrorMessage = "Enter a valid e-mail address.")]
        public string? EmailRestriction { get; set; }

        public string AppliesTo { get; set; } = "NonRefundable";
        public bool IsActive { get; set; } = true;
    }
}
