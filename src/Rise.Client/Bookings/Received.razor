@page "/booking/received"
@* shown after "Pay now" saved the booking, the payment itself is not wired yet *@
@* TODO: replace with the Stripe redirect once the payment story is done *@

<PageTitle>Booking received</PageTitle>

<div class="page">
    <span class="eyebrow">Book a room</span>
    <h1>Booking received</h1>

    @if (!string.IsNullOrWhiteSpace(Number))
    {
        <p class="subtitle received-number">Booking @Number</p>
    }

    <p>We saved your booking. The payment step will follow soon.</p>

    <Button Variant="ButtonVariant.Secondary" Href="" Class="mt-4">Back to home</Button>
</div>

